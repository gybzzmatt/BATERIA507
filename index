<script>
// Nav: transparent over video, solid when scrolled
const nav = document.getElementById('nav');
const hero = document.getElementById('hero');
function updateNav() {
  const heroH = hero.offsetHeight;
  if (scrollY > heroH * 0.7) {
    nav.classList.add('solid');
  } else {
    nav.classList.remove('solid');
  }
}
window.addEventListener('scroll', updateNav);
updateNav();

// Reveal on scroll
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: .1, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// Counters
function animCount(el, target, dur=1800) {
  let start = null;
  (function step(ts) {
    if (!start) start = ts;
    const p = Math.min((ts - start) / dur, 1);
    const ease = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.floor(ease * target).toLocaleString('es-PA');
    if (p < 1) requestAnimationFrame(step);
  })(performance.now());
}
const cObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { animCount(e.target, +e.target.dataset.t); cObs.unobserve(e.target); }
  });
}, { threshold: .5 });
document.querySelectorAll('.cn').forEach(el => cObs.observe(el));

// Testimonials
const reviews = [
  {name:'Carlos M.',loc:'Ciudad de Panamá',init:'CM',q:'"Increíble. Llegaron en 18 minutos. Batería instalada sin problema. Precio justo y técnico muy profesional."'},
  {name:'Rebeca T.',loc:'Miraflores',init:'RT',q:'"Me quedé varada a las 11pm. En 25 minutos ya estaba en camino a casa. Servicio de otra categoría."'},
  {name:'Jorge A.',loc:'San Francisco',init:'JA',q:'"Ya es la segunda vez que los llamo. Siempre puntuales, siempre amables. La garantía también es real."'},
  {name:'María L.',loc:'Costa del Este',init:'ML',q:'"En media hora el técnico ya había terminado. Me explicó todo. Excelente servicio de principio a fin."'},
  {name:'Ricardo P.',loc:'Bella Vista',init:'RP',q:'"Profesionalismo de primer nivel. La batería tiene mejor rendimiento que la anterior. 100% recomendado."'},
];
const inner = document.getElementById('tInner');
const dotsEl = document.getElementById('tDots');
let ci = 0, auto;
reviews.forEach((r, i) => {
  const c = document.createElement('div');
  c.className = 'tc' + (i === 0 ? ' active' : '');
  c.innerHTML = `<div class="stars">★★★★★</div><p class="tc-q">${r.q}</p><div class="tc-auth"><div class="tc-av">${r.init}</div><div><div class="tc-name">${r.name}</div><div class="tc-loc">${r.loc}</div></div><div class="vbdg">Verificado</div></div>`;
  inner.appendChild(c);
  const d = document.createElement('div');
  d.className = 't-dot' + (i === 0 ? ' active' : '');
  d.onclick = () => goTo(i);
  dotsEl.appendChild(d);
});
const cards = inner.querySelectorAll('.tc');
const dots = dotsEl.querySelectorAll('.t-dot');
function goTo(idx) {
  cards[ci].classList.remove('active'); dots[ci].classList.remove('active');
  ci = (idx + reviews.length) % reviews.length;
  cards[ci].classList.add('active'); dots[ci].classList.add('active');
  inner.style.transform = `translateX(-${ci * (cards[0].offsetWidth + 18)}px)`;
}
document.getElementById('tPrev').onclick = () => { clearInterval(auto); goTo(ci-1); startAuto(); };
document.getElementById('tNext').onclick = () => { clearInterval(auto); goTo(ci+1); startAuto(); };
function startAuto() { auto = setInterval(() => goTo(ci+1), 4500); }
startAuto();
window.addEventListener('resize', () => goTo(ci));
</script>
