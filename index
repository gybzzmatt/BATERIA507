<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Batería a domicilio en Panamá — instalación en 30 minutos, 24/7. Servicio certificado ISO 16949. Llámanos ahora.">
<meta property="og:title" content="Baterías 507 — Batería en tu puerta en 30 minutos">
<meta property="og:description" content="Instalación gratis. Pago al recibir. Sin esperas. 24/7.">
<title>Baterías 507 — Batería en tu puerta. En 30 minutos. 24/7.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --dark: #0C0F14;
    --dark2: #131720;
    --dark3: #1A1F2B;
    --card: #161B26;
    --orange: #FF6B1A;
    --orange-dim: rgba(255,107,26,0.15);
    --cyan: #00C8E8;
    --cyan-dim: rgba(0,200,232,0.12);
    --gold: #C9961E;
    --cream: #F5EDD8;
    --green: #0FBA7A;
    --text: #EAE6DF;
    --muted: #8A919F;
    --border: rgba(255,255,255,0.07);
    --border-bright: rgba(255,255,255,0.14);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Barlow', sans-serif;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ======== TYPOGRAPHY ======== */
  .display {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .mono { font-family: 'DM Mono', monospace; }

  /* ======== NOISE TEXTURE OVERLAY ======== */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.025;
    pointer-events: none;
    z-index: 9999;
  }

  /* ======== NAV ======== */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 5%;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(12,15,20,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    transition: height 0.3s, background 0.3s;
  }
  nav.scrolled {
    height: 56px;
    background: rgba(12,15,20,0.96);
  }
  .nav-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--text);
    text-decoration: none;
  }
  .nav-logo span { color: var(--orange); }
  .nav-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--green);
    font-weight: 500;
  }
  .nav-badge::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    animation: blink 1.8s infinite;
  }
  @keyframes blink {
    0%,100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #fff;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 20px;
    border-radius: 4px;
    transition: background 0.2s, transform 0.15s;
  }
  .nav-cta:hover { background: #ff8340; transform: scale(1.03); }

  /* ======== HERO ======== */
  #hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 120px 5% 80px;
    position: relative;
    overflow: hidden;
    gap: 60px;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,107,26,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,107,26,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: grid-drift 20s linear infinite;
  }
  @keyframes grid-drift {
    from { background-position: 0 0; }
    to { background-position: 60px 60px; }
  }

  .hero-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,107,26,0.12) 0%, transparent 65%);
    top: -200px;
    right: -100px;
    pointer-events: none;
    animation: glow-pulse 6s ease-in-out infinite;
  }
  @keyframes glow-pulse {
    0%,100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.08); opacity: 0.7; }
  }

  .hero-content { position: relative; z-index: 2; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 28px;
    opacity: 0;
    animation: fade-up 0.6s 0.2s forwards;
  }
  .hero-eyebrow::before, .hero-eyebrow::after {
    content: '';
    height: 1px;
    width: 24px;
    background: var(--orange);
    opacity: 0.5;
  }

  .hero-title {
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    color: var(--text);
    margin-bottom: 28px;
    opacity: 0;
    animation: fade-up 0.7s 0.35s forwards;
  }
  .hero-title .accent { color: var(--orange); }
  .hero-title .accent2 { color: var(--cyan); }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--muted);
    margin-bottom: 40px;
    font-weight: 400;
    line-height: 1.7;
    max-width: 440px;
    opacity: 0;
    animation: fade-up 0.7s 0.5s forwards;
  }
  .hero-sub strong { color: var(--text); font-weight: 600; }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 48px;
    opacity: 0;
    animation: fade-up 0.7s 0.65s forwards;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #fff;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 16px 32px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s;
    animation: cta-pulse 2.5s ease-in-out infinite;
  }
  @keyframes cta-pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(255,107,26,0.5); }
    50% { box-shadow: 0 0 0 14px rgba(255,107,26,0); }
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { transform: translateY(-2px); animation: none; box-shadow: 0 8px 30px rgba(255,107,26,0.4); }
  .btn-primary:hover::before { opacity: 1; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: var(--cyan);
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: 4px;
    border: 1px solid rgba(0,200,232,0.4);
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-secondary:hover { background: var(--cyan-dim); border-color: var(--cyan); transform: translateY(-2px); }

  .hero-trust {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    opacity: 0;
    animation: fade-up 0.7s 0.8s forwards;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .trust-item .icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--dark3);
    border: 1px solid var(--border-bright);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }
  .trust-item strong { color: var(--text); font-weight: 600; display: block; font-size: 0.88rem; }

  /* ======== BATTERY ANIMATION ======== */
  .hero-visual {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    animation: fade-in 1s 0.4s forwards;
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .battery-wrap {
    position: relative;
    width: 320px;
    height: 320px;
  }
  .battery-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ======== ANIMATIONS ======== */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-left {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }
  .reveal-delay-4 { transition-delay: 0.4s; }

  /* ======== SECTION STYLES ======== */
  section { padding: 100px 5%; }
  .section-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-eyebrow::after {
    content: '';
    height: 1px;
    width: 40px;
    background: var(--orange);
    opacity: 0.4;
  }
  .section-title {
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 0.95;
    margin-bottom: 20px;
  }
  .section-sub {
    color: var(--muted);
    font-size: 1rem;
    max-width: 500px;
    line-height: 1.7;
  }
  .section-header { margin-bottom: 64px; }

  /* ======== PROBLEM SECTION ======== */
  #problems {
    background: var(--dark2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .problem-card {
    background: var(--card);
    padding: 44px 36px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }
  .problem-card:hover { background: var(--dark3); }
  .problem-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .problem-card.red::before { background: #FF4040; }
  .problem-card.cyan::before { background: var(--cyan); }
  .problem-card.orange::before { background: var(--orange); }
  .problem-card:hover::before { opacity: 1; }

  .problem-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 24px;
  }
  .problem-icon.red { background: rgba(255,64,64,0.12); }
  .problem-icon.cyan { background: var(--cyan-dim); }
  .problem-icon.orange { background: var(--orange-dim); }
  .problem-card h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    line-height: 1.1;
  }
  .problem-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .problem-card .solution {
    margin-top: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .problem-card.red .solution { color: #FF6060; }
  .problem-card.cyan .solution { color: var(--cyan); }
  .problem-card.orange .solution { color: var(--orange); }

  /* ======== HOW IT WORKS ======== */
  #how {
    position: relative;
  }
  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
  }
  .how-steps::before {
    content: '';
    position: absolute;
    top: 52px;
    left: 16.66%;
    right: 16.66%;
    height: 1px;
    background: linear-gradient(90deg, var(--cyan), var(--orange), var(--green));
    opacity: 0.3;
  }
  .how-step {
    padding: 0 32px;
    text-align: center;
    position: relative;
  }
  .step-num {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--border-bright);
    background: var(--dark2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px;
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    position: relative;
    z-index: 2;
  }
  .step-num.cyan { border-color: var(--cyan); color: var(--cyan); }
  .step-num.orange { border-color: var(--orange); color: var(--orange); }
  .step-num.green { border-color: var(--green); color: var(--green); }
  .how-step h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .how-step p { color: var(--muted); font-size: 0.9rem; line-height: 1.7; }
  .step-icon { font-size: 2rem; margin-bottom: 20px; display: block; }

  /* ======== WHY US (STATS) ======== */
  #why {
    background: var(--dark2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .why-card {
    background: var(--card);
    padding: 40px 28px;
    transition: background 0.3s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }
  .why-card:hover { background: #1E2330; }
  .why-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(255,107,26,0.06), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .why-card:hover::after { opacity: 1; }
  .why-number {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 3.6rem;
    line-height: 1;
    color: var(--orange);
    display: block;
    margin-bottom: 8px;
  }
  .why-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
    color: var(--text);
  }
  .why-desc { font-size: 0.83rem; color: var(--muted); line-height: 1.6; }
  .why-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(15,186,122,0.12);
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    margin-top: 12px;
  }

  /* ======== SERVICES ======== */
  #services { background: var(--dark); }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .service-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 40px 32px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    cursor: default;
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-bright);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .service-card.s1::before { background: radial-gradient(circle at 80% 20%, rgba(255,107,26,0.08), transparent 60%); }
  .service-card.s2::before { background: radial-gradient(circle at 80% 20%, rgba(201,150,30,0.08), transparent 60%); }
  .service-card.s3::before { background: radial-gradient(circle at 80% 20%, rgba(0,200,232,0.08), transparent 60%); }
  .service-card:hover::before { opacity: 1; }
  .service-icon {
    font-size: 2.2rem;
    margin-bottom: 24px;
    display: block;
    line-height: 1;
  }
  .service-card h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    line-height: 1.05;
  }
  .service-card p { color: var(--muted); font-size: 0.88rem; line-height: 1.7; margin-bottom: 24px; }
  .service-cta {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s;
  }
  .s1 .service-cta { color: var(--orange); }
  .s2 .service-cta { color: var(--gold); }
  .s3 .service-cta { color: var(--cyan); }
  .service-card:hover .service-cta { gap: 14px; }
  .service-tag {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
  }
  .tag-hot { background: var(--orange-dim); color: var(--orange); }
  .tag-pro { background: rgba(201,150,30,0.12); color: var(--gold); }
  .tag-new { background: var(--cyan-dim); color: var(--cyan); }

  /* ======== TESTIMONIALS ======== */
  #testimonials {
    background: var(--dark2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .testimonials-track { position: relative; overflow: hidden; }
  .testimonials-inner {
    display: flex;
    gap: 20px;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .testimonial-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 36px;
    min-width: 340px;
    flex-shrink: 0;
    transition: border-color 0.3s;
  }
  .testimonial-card.active { border-color: rgba(255,107,26,0.3); }
  .stars { color: var(--gold); font-size: 1.1rem; margin-bottom: 20px; letter-spacing: 3px; }
  .testimonial-quote {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 24px;
    font-style: italic;
  }
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--dark3);
    border: 1px solid var(--border-bright);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--orange);
  }
  .author-name { font-weight: 600; font-size: 0.88rem; }
  .author-meta { font-size: 0.78rem; color: var(--muted); }
  .verified-badge {
    margin-left: auto;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    background: rgba(15,186,122,0.1);
    padding: 3px 8px;
    border-radius: 3px;
  }
  .testimonials-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }
  .testi-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--dark3);
    border: 1px solid var(--border-bright);
    color: var(--text);
    font-size: 1.1rem;
