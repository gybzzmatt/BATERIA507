<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Baterías 507 — Tu Aliado en la Vía</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;0,900;1,800;1,900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --navy:   #292a81;
  --blue:   #1b48ea;
  --orange: #FF6B1A;
  --white:  #ffffff;
  --off:    #F5F6FA;
  --text:   #0d0e2e;
  --muted:  #5A6070;
  --border: rgba(41,42,129,0.12);
  --green:  #10B981;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Barlow',sans-serif;
  background:var(--white);
  color:var(--text);
  overflow-x:hidden;
}

/* ════════════════════════════════
   NAV
════════════════════════════════ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:500;
  height:70px;display:flex;align-items:center;
  justify-content:space-between;padding:0 5%;
  transition:height .4s,background .4s,box-shadow .4s;
  background:transparent;
}
nav.solid{
  height:58px;
  background:rgba(255,255,255,0.97);
  backdrop-filter:blur(20px);
  box-shadow:0 2px 28px rgba(41,42,129,0.1);
  border-bottom:1px solid var(--border);
}

.nav-logo img{
  height:44px;width:auto;
  transition:height .4s,filter .4s;
  filter:none;
}
nav:not(.solid) .nav-logo img{
  filter:brightness(0) invert(1);
  height:40px;
}
nav.solid .nav-logo img{ height:36px; }

.nav-live{
  display:flex;align-items:center;gap:7px;
  font-size:.72rem;font-weight:700;
  letter-spacing:.18em;text-transform:uppercase;
  color:var(--green);
}
nav:not(.solid) .nav-live{ color:rgba(255,255,255,0.85); }
.nav-live::before{
  content:'';width:7px;height:7px;
  border-radius:50%;background:var(--green);
  animation:blink 1.8s infinite;
}
nav:not(.solid) .nav-live::before{ background:rgba(255,255,255,0.85); }
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}

.nav-cta{
  display:inline-flex;align-items:center;gap:9px;
  background:var(--orange);color:#fff;
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1rem;
  letter-spacing:.1em;text-transform:uppercase;
  padding:10px 26px;border-radius:4px;
  text-decoration:none;
  animation:pulse-o 2.8s ease-in-out infinite;
  transition:background .2s,transform .15s;
}
@keyframes pulse-o{
  0%,100%{box-shadow:0 0 0 0 rgba(255,107,26,.5)}
  50%{box-shadow:0 0 0 14px rgba(255,107,26,0)}
}
.nav-cta:hover{background:#e55a0a;transform:scale(1.03);animation:none}

/* ════════════════════════════════
   HERO — VIDEO BG FULL BLEED
════════════════════════════════ */
#hero{
  position:relative;
  height:100vh;min-height:600px;
  overflow:hidden;
  display:flex;align-items:center;
}

/* Video fills full hero */
.hero-video-bg{
  position:absolute;inset:0;
  width:100%;height:100%;
  object-fit:cover;
  object-position:center;
  z-index:0;
}

/* Multi-layer overlay for readability */
.hero-overlay{
  position:absolute;inset:0;z-index:1;
  background:
    linear-gradient(
      to right,
      rgba(41,42,129,0.85) 0%,
      rgba(41,42,129,0.65) 45%,
      rgba(27,72,234,0.3) 75%,
      rgba(41,42,129,0.55) 100%
    ),
    linear-gradient(
      to bottom,
      rgba(0,0,0,0.25) 0%,
      transparent 30%,
      transparent 70%,
      rgba(0,0,0,0.4) 100%
    );
}

/* Grain texture */
.hero-overlay::after{
  content:'';
  position:absolute;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity:.04;
}

/* Hero content */
.hero-content{
  position:relative;z-index:2;
  padding:0 7%;
  max-width:780px;
}

.hero-eyebrow{
  display:inline-flex;align-items:center;gap:12px;
  font-size:.72rem;font-weight:700;
  letter-spacing:.24em;text-transform:uppercase;
  color:rgba(255,255,255,.7);
  margin-bottom:28px;
  opacity:0;animation:fadeUp .6s .2s forwards;
}
.hero-eyebrow::before,.hero-eyebrow::after{
  content:'';width:28px;height:1.5px;
  background:var(--orange);
}

.hero-h1{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:900;text-transform:uppercase;
  font-size:clamp(4rem,8vw,9rem);
  line-height:.88;letter-spacing:-.02em;
  color:var(--white);
  margin-bottom:32px;
  opacity:0;animation:fadeUp .8s .35s forwards;
}
.hero-h1 .ln{display:block}
.hero-h1 .ora{color:var(--orange);font-style:italic}
.hero-h1 .blu{color:#60a5fa;font-style:italic}

.hero-sub{
  font-size:1.1rem;color:rgba(255,255,255,.75);
  max-width:440px;line-height:1.72;
  margin-bottom:44px;font-weight:400;
  opacity:0;animation:fadeUp .7s .52s forwards;
}
.hero-sub strong{color:var(--white);font-weight:700}

.hero-ctas{
  display:flex;gap:14px;flex-wrap:wrap;
  margin-bottom:56px;
  opacity:0;animation:fadeUp .7s .66s forwards;
}
.btn-p{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--orange);color:#fff;
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1.1rem;
  letter-spacing:.1em;text-transform:uppercase;
  padding:16px 34px;border-radius:4px;
  text-decoration:none;border:none;cursor:pointer;
  animation:pulse-o 2.5s ease-in-out infinite;
  transition:transform .2s;
}
.btn-p:hover{transform:translateY(-2px);animation:none;box-shadow:0 12px 36px rgba(255,107,26,.5)}
.btn-s{
  display:inline-flex;align-items:center;gap:10px;
  background:rgba(255,255,255,.12);
  backdrop-filter:blur(10px);
  color:var(--white);
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1.1rem;
  letter-spacing:.1em;text-transform:uppercase;
  padding:15px 30px;border-radius:4px;
  text-decoration:none;
  border:2px solid rgba(255,255,255,.35);
  transition:all .25s;
}
.btn-s:hover{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.6);transform:translateY(-2px)}

/* Trust pills */
.hero-trust{
  display:flex;gap:12px;flex-wrap:wrap;
  opacity:0;animation:fadeUp .7s .8s forwards;
}
.trust-pill{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.1);
  backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.2);
  border-radius:100px;
  padding:7px 16px;
  font-size:.82rem;color:rgba(255,255,255,.9);font-weight:500;
}
.trust-pill strong{color:var(--white);font-weight:700;margin-right:2px}

/* Scroll indicator */
.scroll-hint{
  position:absolute;bottom:32px;left:50%;transform:translateX(-50%);
  z-index:2;display:flex;flex-direction:column;align-items:center;gap:8px;
  opacity:0;animation:fadeIn 1s 1.2s forwards;
}
.scroll-hint span{
  font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;
  color:rgba(255,255,255,.4);font-weight:600;
}
.scroll-arrow{
  width:24px;height:36px;border:2px solid rgba(255,255,255,.3);
  border-radius:12px;display:flex;align-items:flex-start;justify-content:center;
  padding-top:4px;
}
.scroll-dot{
  width:4px;height:8px;border-radius:2px;
  background:rgba(255,255,255,.6);
  animation:scroll-bounce 2s ease-in-out infinite;
}
@keyframes scroll-bounce{
  0%,100%{transform:translateY(0);opacity:1}
  60%{transform:translateY(14px);opacity:.2}
}

@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* ════════════════════════════════
   TRANSITION STRIPE
════════════════════════════════ */
.stripe{
  height:6px;
  background:linear-gradient(90deg,var(--orange) 0%,var(--blue) 50%,var(--navy) 100%);
}

/* ════════════════════════════════
   REVEAL
════════════════════════════════ */
.reveal{opacity:0;transform:translateY(32px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
.d1{transition-delay:.08s}.d2{transition-delay:.18s}.d3{transition-delay:.28s}.d4{transition-delay:.38s}

/* ════════════════════════════════
   SHARED
════════════════════════════════ */
section{padding:100px 5%}
.eyebrow{
  font-size:.68rem;font-weight:700;
  letter-spacing:.22em;text-transform:uppercase;
  color:var(--orange);margin-bottom:14px;
  display:flex;align-items:center;gap:10px;
}
.eyebrow::after{content:'';width:36px;height:1.5px;background:var(--orange)}
.eyebrow.center{justify-content:center}
.eyebrow.center::before{content:'';width:36px;height:1.5px;background:var(--orange)}
.sec-title{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:900;text-transform:uppercase;
  font-size:clamp(2.4rem,3.8vw,4rem);
  line-height:.92;letter-spacing:-.01em;
  margin-bottom:16px;color:var(--navy);
}
.sec-sub{color:var(--muted);max-width:480px;font-size:.95rem;line-height:1.72}
.sec-hd{margin-bottom:60px}

/* ════════════════════════════════
   PROBLEM SECTION
════════════════════════════════ */
#problems{background:var(--off);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.probs{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:2px;background:var(--border);
  border:1px solid var(--border);border-radius:8px;overflow:hidden;
}
.prob{
  background:var(--white);padding:44px 34px;
  position:relative;overflow:hidden;transition:background .3s;
}
.prob:hover{background:#fafbff}
.prob::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  opacity:0;transition:opacity .3s;
}
.prob.a::before{background:var(--orange)}
.prob.b::before{background:var(--blue)}
.prob.c::before{background:var(--navy)}
.prob:hover::before{opacity:1}
.prob-ico{
  width:54px;height:54px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.5rem;margin-bottom:22px;
}
.prob.a .prob-ico{background:rgba(255,107,26,.1)}
.prob.b .prob-ico{background:rgba(27,72,234,.1)}
.prob.c .prob-ico{background:rgba(41,42,129,.1)}
.prob h3{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800;font-size:1.4rem;
  text-transform:uppercase;letter-spacing:.04em;
  margin-bottom:12px;line-height:1.05;color:var(--navy);
}
.prob p{color:var(--muted);font-size:.9rem;line-height:1.7;margin-bottom:20px}
.prob-tag{
  font-size:.72rem;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;display:flex;align-items:center;gap:6px;
}
.prob.a .prob-tag{color:var(--orange)}
.prob.b .prob-tag{color:var(--blue)}
.prob.c .prob-tag{color:var(--navy)}

/* ════════════════════════════════
   HOW
════════════════════════════════ */
#how{background:var(--white)}
.how{display:grid;grid-template-columns:repeat(3,1fr);position:relative}
.how::before{
  content:'';position:absolute;
  top:44px;left:16.5%;right:16.5%;height:2px;
  background:linear-gradient(90deg,var(--orange),var(--blue),var(--green));
  opacity:.2;
}
.how-step{padding:0 32px;text-align:center}
.step-n{
  width:50px;height:50px;border-radius:50%;
  border:2px solid;
  background:var(--white);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 24px;position:relative;z-index:2;
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800;font-size:.88rem;
}
.step-n.o{border-color:var(--orange);color:var(--orange)}
.step-n.b{border-color:var(--blue);color:var(--blue)}
.step-n.g{border-color:var(--green);color:var(--green)}
.step-em{font-size:2.2rem;margin-bottom:18px;display:block}
.how-step h3{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800;font-size:1.4rem;
  text-transform:uppercase;letter-spacing:.05em;
  margin-bottom:10px;color:var(--navy);
}
.how-step p{color:var(--muted);font-size:.88rem;line-height:1.7}

/* ════════════════════════════════
   STATS (DARK)
════════════════════════════════ */
#stats{background:var(--navy);padding:96px 5%}
#stats .eyebrow{color:var(--orange)}
#stats .sec-title{color:var(--white)}
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:2px;background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.1);border-radius:8px;overflow:hidden;
}
.stat{background:#1e1f60;padding:38px 26px;transition:background .3s;cursor:default}
.stat:hover{background:#252677}
.stat-n{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:900;font-size:3.4rem;line-height:1;
  color:var(--orange);display:block;margin-bottom:6px;
}
.stat-l{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1rem;
  text-transform:uppercase;letter-spacing:.06em;
  margin-bottom:8px;color:var(--white);
}
.stat-d{font-size:.8rem;color:rgba(255,255,255,.45);line-height:1.6}
.stat-b{
  display:inline-flex;align-items:center;gap:5px;
  background:rgba(16,185,122,.12);color:var(--green);
  font-size:.68rem;font-weight:700;
  letter-spacing:.12em;text-transform:uppercase;
  padding:3px 8px;border-radius:3px;margin-top:10px;
}

/* ════════════════════════════════
   SERVICES
════════════════════════════════ */
#services{background:var(--off)}
.svcs{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.svc{
  background:var(--white);border:1px solid var(--border);
  border-radius:8px;padding:40px 30px;
  position:relative;overflow:hidden;
  transition:transform .3s,box-shadow .3s,border-color .3s;
}
.svc:hover{transform:translateY(-6px);box-shadow:0 24px 64px rgba(41,42,129,.12);border-color:rgba(41,42,129,.25)}
.svc::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity .4s}
.svc.s1::before{background:radial-gradient(circle at 80% 10%,rgba(255,107,26,.06),transparent 60%)}
.svc.s2::before{background:radial-gradient(circle at 80% 10%,rgba(27,72,234,.06),transparent 60%)}
.svc.s3::before{background:radial-gradient(circle at 80% 10%,rgba(41,42,129,.06),transparent 60%)}
.svc:hover::before{opacity:1}
.svc-badge{
  position:absolute;top:22px;right:22px;
  font-size:.66rem;font-weight:700;
  letter-spacing:.13em;text-transform:uppercase;
  padding:3px 10px;border-radius:3px;
}
.bh{background:rgba(255,107,26,.1);color:var(--orange)}
.bb{background:rgba(27,72,234,.1);color:var(--blue)}
.bn{background:rgba(41,42,129,.1);color:var(--navy)}
.svc-ico{font-size:2.2rem;margin-bottom:22px;display:block}
.svc h3{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800;font-size:1.55rem;
  text-transform:uppercase;letter-spacing:.04em;
  margin-bottom:12px;line-height:1.05;color:var(--navy);
}
.svc p{color:var(--muted);font-size:.88rem;line-height:1.7;margin-bottom:24px}
.svc-lnk{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:.82rem;
  letter-spacing:.15em;text-transform:uppercase;
  text-decoration:none;display:inline-flex;align-items:center;gap:8px;
  transition:gap .2s;
}
.s1 .svc-lnk{color:var(--orange)}
.s2 .svc-lnk{color:var(--blue)}
.s3 .svc-lnk{color:var(--navy)}
.svc:hover .svc-lnk{gap:14px}

/* ════════════════════════════════
   TESTIMONIALS
════════════════════════════════ */
#testi{background:var(--white);border-top:1px solid var(--border)}
.testi-hd{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px}
.testi-track{overflow:hidden}
.testi-inner{display:flex;gap:18px;transition:transform .6s cubic-bezier(.25,.46,.45,.94)}
.tc{
  background:var(--off);border:1px solid var(--border);
  border-radius:8px;padding:36px;min-width:330px;flex-shrink:0;
  transition:border-color .3s,box-shadow .3s;
}
.tc.active{border-color:var(--orange);box-shadow:0 4px 28px rgba(255,107,26,.1)}
.stars{color:#F59E0B;font-size:1rem;margin-bottom:18px;letter-spacing:3px}
.tc-q{font-size:.93rem;line-height:1.77;color:var(--text);margin-bottom:24px;font-style:italic}
.tc-auth{display:flex;align-items:center;gap:12px}
.tc-av{
  width:40px;height:40px;border-radius:50%;
  background:rgba(41,42,129,.1);border:2px solid rgba(41,42,129,.2);
  display:flex;align-items:center;justify-content:center;
  font-family:'Barlow Condensed',sans-serif;
  font-weight:800;font-size:.88rem;color:var(--navy);
}
.tc-name{font-weight:700;font-size:.88rem;color:var(--navy)}
.tc-loc{font-size:.76rem;color:var(--muted)}
.vbdg{
  margin-left:auto;font-size:.66rem;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;
  color:var(--green);background:rgba(16,185,122,.1);
  padding:3px 8px;border-radius:3px;
}
.t-ctrl{display:flex;align-items:center;gap:14px}
.t-btn{
  width:44px;height:44px;border-radius:50%;
  background:var(--off);border:1px solid var(--border);
  color:var(--navy);cursor:pointer;font-size:1rem;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;
}
.t-btn:hover{background:var(--orange);border-color:var(--orange);color:#fff}
.t-dots{display:flex;gap:5px}
.t-dot{width:5px;height:5px;border-radius:3px;background:var(--border);cursor:pointer;transition:all .3s}
.t-dot.active{width:22px;background:var(--orange)}

/* ════════════════════════════════
   FINAL CTA
════════════════════════════════ */
#cta{
  position:relative;text-align:center;
  padding:130px 5%;overflow:hidden;
  background:var(--navy);
}
.cta-bg{
  position:absolute;inset:0;
  background:radial-gradient(ellipse 60% 70% at 50% 50%,rgba(27,72,234,.3) 0%,transparent 70%);
}
.cta-grid{
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
  background-size:64px 64px;
}
#cta .eyebrow{color:rgba(255,255,255,.4);justify-content:center;position:relative;z-index:1}
#cta .eyebrow::before{content:'';width:36px;height:1.5px;background:rgba(255,255,255,.3)}
#cta .eyebrow::after{background:rgba(255,255,255,.3)}
.cta-h2{
  font-family:'Barlow Condensed',sans-serif;
  font-weight:900;text-transform:uppercase;
  font-size:clamp(3rem,5.5vw,6rem);
  line-height:.9;margin-bottom:24px;color:var(--white);
  position:relative;z-index:1;
}
.cta-sub{color:rgba(255,255,255,.5);font-size:1rem;margin-bottom:52px;position:relative;z-index:1}
.cta-btns{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;position:relative;z-index:1}
.btn-white{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--white);color:var(--navy);
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1.1rem;
  letter-spacing:.1em;text-transform:uppercase;
  padding:17px 38px;border-radius:4px;
  text-decoration:none;transition:all .2s;
}
.btn-white:hover{background:var(--orange);color:#fff;transform:translateY(-2px)}
.btn-ghost{
  display:inline-flex;align-items:center;gap:10px;
  background:transparent;color:var(--white);
  font-family:'Barlow Condensed',sans-serif;
  font-weight:700;font-size:1.1rem;
  letter-spacing:.1em;text-transform:uppercase;
  padding:16px 34px;border-radius:4px;
  text-decoration:none;
  border:2px solid rgba(255,255,255,.28);
  transition:all .2s;
}
.btn-ghost:hover{border-color:var(--white);background:rgba(255,255,255,.1);transform:translateY(-2px)}
.cta-urgency{
  margin-top:24px;font-size:.76rem;
  color:rgba(255,255,255,.35);letter-spacing:.08em;
  position:relative;z-index:1;
}
.cta-urgency span{color:var(--green);font-weight:600}

