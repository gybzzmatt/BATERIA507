<script>
// ---- NAV scroll ----
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 60);
});

// ---- Reveal on scroll ----
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
reveals.forEach(el => observer.observe(el));

// ---- Counter animation ----
function animateCounter(el, target, duration = 1800) {
  let start = null;
  const step = (ts) => {
    if (!start) start = ts;
    const progress = Math.min((ts - start) / duration, 1);
    const ease = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.floor(ease * target).toLocaleString('es-PA');
    if (progress < 1) requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}

const counterObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const target = parseInt(e.target.dataset.target);
      animateCounter(e.target, target);
      counterObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.5 });
document.querySelectorAll('.count-num').forEach(el => counterObserver.observe(el));

// ---- Testimonials ----
const testimonials = [
  { name: 'Carlos M.', location: 'Ciudad de Panamá', quote: '"Increíble. Llegaron en 18 minutos. Batería instalada sin problema. Precio justo y el técnico muy profesional. 100% recomendado."', initials: 'CM' },
  { name: 'Rebeca T.', location: 'Miraflores', quote: '"Me quedé varada a las 11pm y llamé sin esperanza. En 25 minutos ya estaba en camino a casa. Servicio de otra categoría."', initials: 'RT' },
  { name: 'Jorge A.', location: 'San Francisco', quote: '"Ya es la segunda vez que los llamo. Siempre puntuales, siempre amables. No iría a otro lugar. Muy buena garantía también."', initials: 'JA' },
  { name: 'María L.', location: 'Costa del Este', quote: '"Pensé que iba a tardar horas. En media hora el técnico ya había terminado. Además me explicó todo el proceso. Excelente."', initials: 'ML' },
  { name: 'Ricardo P.', location: 'Bella Vista', quote: '"Profesionalismo de primer nivel. La batería que instalaron tiene mucho mejor rendimiento que la anterior. Vale cada centavo."', initials: 'RP' },
];

const inner = document.getElementById('testimonialsInner');
const dotsEl = document.getElementById('dots');
let currentIdx = 0;
let autoplay;

testimonials.forEach((t, i) => {
  const card = document.createElement('div');
  card.className = 'testimonial-card' + (i === 0 ? ' active' : '');
  card.innerHTML = `
    <div class="stars">★★★★★</div>
    <p class="testimonial-quote">${t.quote}</p>
    <div class="testimonial-author">
      <div class="author-avatar">${t.initials}</div>
      <div>
        <div class="author-name">${t.name}</div>
        <div class="author-meta">${t.location}</div>
      </div>
      <div class="verified-badge">Verificado</div>
    </div>`;
  inner.appendChild(card);

  const dot = document.createElement('div');
  dot.className = 'testi-dot' + (i === 0 ? ' active' : '');
  dot.onclick = () => goTo(i);
  dotsEl.appendChild(dot);
});

const cards = inner.querySelectorAll('.testimonial-card');
const dots = dotsEl.querySelectorAll('.testi-dot');

function goTo(idx) {
  cards[currentIdx].classList.remove('active');
  dots[currentIdx].classList.remove('active');
  currentIdx = (idx + testimonials.length) % testimonials.length;
  cards[currentIdx].classList.add('active');
  dots[currentIdx].classList.add('active');
  const cardW = cards[0].offsetWidth + 20;
  inner.style.transform = `translateX(-${currentIdx * cardW}px)`;
}

document.getElementById('prev').onclick = () => { clearInterval(autoplay); goTo(currentIdx - 1); startAuto(); };
document.getElementById('next').onclick = () => { clearInterval(autoplay); goTo(currentIdx + 1); startAuto(); };

function startAuto() {
  autoplay = setInterval(() => goTo(currentIdx + 1), 4500);
}
startAuto();

window.addEventListener('resize', () => goTo(currentIdx));
</script>
